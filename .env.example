# Configurações do Supabase (Obrigatório - RNF002: Segredos fora do código)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable-aqui
# Opcional: Caso utilize Service Role Key no backend
SUPABASE_SERVICE_ROLE_KEY=

# Chave secreta para assinatura HMAC-SHA256 do Voucher/QR Code (Obrigatório - RNF003)
SECRET_TOKEN_KEY=defina-sua-chave-hmac-secreta-aqui

# Configurações do Servidor HTTP/HTTPS (NestJS)
HOST=127.0.0.1
PORT=5000
FORCE_HTTPS=false
# Opcional: Caminhos para certificado TLS local (caso deseje rodar HTTPS localmente)
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Limite de SLA do RNF001 em milissegundos (Padrão: 60000 ms = 60 segundos)
RNF001_SLA_LIMIT_MS=60000

# Sprint 3 (todas opcionais)
# Horas que a loja tem para separar o pedido pago antes da reserva vencer (S3-24)
RESERVA_HORAS=48
# true = a fila do operador libera sozinha as reservas vencidas
RESERVA_AUTO_EXPIRAR=false
# Frete simulado dos itens com entrega, em reais (S3-20)
FRETE_SIMULADO=19.90
# false = o codigo do terceiro NAO volta na resposta (use quando houver servico de e-mail) (S3-18)
CODIGO_TERCEIRO_EM_RESPOSTA=true
