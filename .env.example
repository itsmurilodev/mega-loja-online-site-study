# Configurações do Supabase (Obrigatório - RNF002: Segredos fora do código)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable-aqui
# Opcional: Caso utilize Service Role Key no backend
SUPABASE_SERVICE_ROLE_KEY=

# Chave secreta para assinatura HMAC-SHA256 do Voucher/QR Code (Obrigatório - RNF003)
SECRET_TOKEN_KEY=defina-sua-chave-hmac-secreta-aqui

# Configurações do Servidor HTTP/HTTPS (NestJS)
HOST=127.0.0.1
PORT=5000
FORCE_HTTPS=false
# Opcional: Caminhos para certificado TLS local (caso deseje rodar HTTPS localmente)
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Limite de SLA do RNF001 em milissegundos (Padrão: 60000 ms = 60 segundos)
RNF001_SLA_LIMIT_MS=60000
